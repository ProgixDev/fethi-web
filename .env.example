# fethi-web (mystreet-web) — environment template. Copy to `.env.local` and fill in.
# `.env.local` is gitignored; NEVER commit real keys. Only NEXT_PUBLIC_* reach the
# browser — service-role / secret keys stay server-only (route handlers, Edge Functions).

# --- Client (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server only (admin/marketing route handlers, Edge Functions) ---
# Service / secret key — full DB access, bypasses RLS. Server-side ONLY.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Tooling: `npm run db:types` + db-drift CI ---
# The linked remote project-ref (matches supabase/config.toml project_id).
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
# CI uses a Supabase access token (sbp_...) with --project-id.
SUPABASE_ACCESS_TOKEN=sbp_xxx
# Local alternative to the access token: a direct Postgres connection string
# (URL-encode special chars in the password). If set, db:types prefers this.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
